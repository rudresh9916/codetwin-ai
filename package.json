{
  "name": "codetwin-ai",
  "private": true,
  "description": "CodeTwin AI - one-command scripts for Windows (run from this folder)",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "npm --prefix frontend run build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "test": "backend\\.venv\\Scripts\\python -m pytest -q backend/tests"
  }
}
