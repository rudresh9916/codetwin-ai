# Copy to .env (used by docker compose) or export in your shell.
# AI provider: anthropic | openai | ollama | none
CODETWIN_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CODETWIN_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking depth vs. speed and cost)
CODETWIN_ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
CODETWIN_OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://host.docker.internal:11434
CODETWIN_OLLAMA_MODEL=llama3.1
# auto | none | openai | ollama  (dense embeddings fused with BM25)
CODETWIN_EMBEDDINGS=auto
